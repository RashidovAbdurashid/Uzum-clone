# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js (required)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Everything below is optional right now -----------------------------
# The app currently runs on an in-memory mock database (src/lib/mock-db.ts)
# and in-memory OTP store (src/lib/otp-store.ts), so none of this is needed
# to run `npm run dev`. It's here for when you reintroduce real services.

# Database (not used yet)
DATABASE_URL="postgresql://uzum:uzum@localhost:5432/uzum_clone?schema=public"

# Redis (not used yet)
REDIS_URL="redis://localhost:6379"

# Meilisearch (not used yet)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="masterKey"

# MinIO / S3 (not used yet)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="uzum-clone"

# Email - Resend (not used yet)
RESEND_API_KEY=""
EMAIL_FROM="no-reply@uzum-clone.local"

# SMS - Eskiz.uz (optional: without it, OTP codes are just logged to the
# server console in development instead of being sent as real SMS)
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_BASE_URL="https://notify.eskiz.uz/api"

# Payments (not used yet)
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""

# Sentry (not used yet)
NEXT_PUBLIC_SENTRY_DSN=""
